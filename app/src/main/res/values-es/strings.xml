    <!-- Onboarding — un recorrido narrado: bienvenida, launcher, gestos, foco, permisos -->
    <string name="onboarding_p1_kicker">Foco</string>
    <string name="onboarding_p1_title">Tu teléfono, en silencio.</string>
    <string name="onboarding_p1_body">Una pantalla de inicio que se corre del camino, para que tu atención vaya donde vos querés.</string>
    <string name="onboarding_p2_kicker">Empezar</string>
    <string name="onboarding_p2_title">Un inicio en blanco.</string>
    <string name="onboarding_p2_body">Solo texto. Sin íconos que griten por un toque, sin grilla que llenar. Ponelo como tu launcher para empezar.</string>
    <string name="onboarding_p3_kicker">Gestos</string>
    <string name="onboarding_p3_title">Todo a un gesto.</string>
    <string name="onboarding_p3_body">Deslizá y aparecen tus apps, tus widgets o una app al instante. Vos elegís hacia qué lado vive cada cosa.</string>
    <string name="onboarding_p4_kicker">Widgets</string>
    <string name="onboarding_p4_title">Lo justo, a mano.</string>
    <string name="onboarding_p4_body">Sumá los widgets que de verdad usás —el clima, tu agenda, la música— y dales el tamaño exacto. Sin relleno, sin ruido.</string>
    <string name="onboarding_p5_kicker">Modo foco</string>
    <string name="onboarding_p5_title">Cuando querés concentrarte.</string>
    <string name="onboarding_p5_body">Elegí las apps que te dispersan y Foco las frena antes de que se abran —o las cierra del todo— en todo el teléfono, no solo acá. Un temporizador rápido cuando lo necesitás, o sesiones que se arman solas según tus horarios.</string>
    <string name="onboarding_friction_kicker">Fricción</string>
    <string name="onboarding_friction_title">Un instante antes de abrir.</string>
    <string name="onboarding_friction_body">Cuando vas a abrir una app que te distrae, Foco interpone una breve pausa —con un contador— antes de dejarte entrar. Lo justo para preguntarte si de verdad la necesitás ahora. No la bloquea: convierte un reflejo en una elección.</string>
    <string name="onboarding_limits_kicker">Límites diarios</string>
    <string name="onboarding_limits_title">Un tope para cada app.</string>
    <string name="onboarding_limits_body">Dale a una app unos minutos por día. Cuando se agota el tiempo, Foco la pausa por el resto del día — un freno suave, no un bloqueo total. Ideal para las apps que querés conservar, pero usar menos.</string>
    <string name="onboarding_strict_kicker">Modo estricto</string>
    <string name="onboarding_strict_title">Sin puerta de escape.</string>
    <string name="onboarding_strict_body">En una sesión de foco con fin fijo, el modo estricto oculta la salida hasta que el temporizador llega a cero — para que un momento de debilidad no eche por tierra el plan que hiciste en uno más lúcido.</string>
    <string name="onboarding_dnd_kicker">No molestar</string>
    <string name="onboarding_dnd_title">Silencio, mientras dure.</string>
    <string name="onboarding_dnd_body">Foco puede activar No molestar apenas empieza el foco y quitarlo apenas termina — sin vibraciones ni avisos compitiendo por la atención que acabás de reservar.</string>
    <string name="onboarding_p6_kicker">Casi listo</string>
    <string name="onboarding_p6_title">Para que funcione de verdad.</string>
    <string name="onboarding_p6_body">Dos permisos opcionales activan el tiempo de uso y el bloqueo real en todo el teléfono. Vos elegís: Foco funciona sin ellos.</string>
    <string name="onboarding_perm_usage">Screen Time</string>
    <string name="onboarding_perm_usage_body">Ver tu tiempo de uso y poner límites.</string>
    <string name="onboarding_perm_a11y">Gesto de notificaciones y bloqueo</string>
    <string name="onboarding_perm_a11y_body">Bajar notificaciones y bloquear la pantalla desde el inicio.</string>
