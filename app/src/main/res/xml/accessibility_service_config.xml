<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy-respecting by design: the service can NOT read screen content
  (canRetrieveWindowContent="false"). It subscribes only to window-state changes to learn which
  app is in the foreground (the package name only), which powers two user-enabled features:
  performGlobalAction gestures (notification shade / lock) and enforcing the user's own focus
  blocks system-wide. It never reads or collects on-screen content.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/accessibility_description" />
