<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately minimal: the service subscribes to NO accessibility events
  (accessibilityEventTypes is absent) and cannot read screen content
  (canRetrieveWindowContent="false"). Its only job is performGlobalAction on an
  explicit user gesture — expand the notification shade / lock the screen. This
  keeps it as privacy-respecting as possible for Play's accessibility review.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_description" />
