    <!-- Onboarding — a narrated tour: welcome, set default, gestures, focus, permissions -->
    <string name="onboarding_p1_kicker">Foco</string>
    <string name="onboarding_p1_title">Your phone, quiet.</string>
    <string name="onboarding_p1_body">A home screen that gets out of your way, so your attention goes where you want it.</string>
    <string name="onboarding_p2_kicker">Start</string>
    <string name="onboarding_p2_title">A blank home.</string>
    <string name="onboarding_p2_body">Just text. No icons shouting for a tap, no grid to fill. Set Foco as your launcher to begin.</string>
    <string name="onboarding_p3_kicker">Gestures</string>
    <string name="onboarding_p3_title">Everything is a swipe.</string>
    <string name="onboarding_p3_body">Swipe and your apps, your widgets or a quick app appear. You choose which way each one lives.</string>
    <string name="onboarding_p4_kicker">Widgets</string>
    <string name="onboarding_p4_title">Just what you need.</string>
    <string name="onboarding_p4_body">Add the widgets you actually use — weather, your calendar, music — and size them exactly. No filler, no clutter.</string>
    <string name="onboarding_p5_kicker">Focus mode</string>
    <string name="onboarding_p5_title">When you want to concentrate.</string>
    <string name="onboarding_p5_body">Pick the apps that pull you away and Foco slows them down before they open — or closes them off entirely — across your whole phone, not just here. A quick timer when you need it, or sessions that arm themselves on your schedule.</string>
    <string name="onboarding_friction_kicker">Friction</string>
    <string name="onboarding_friction_title">A beat before you open.</string>
    <string name="onboarding_friction_body">When you reach for an app that pulls you away, Foco puts a short pause — with a countdown — in front of it before letting you in. Just long enough to ask whether you really need it right now. It doesn\'t block; it turns a reflex into a choice.</string>
    <string name="onboarding_limits_kicker">Daily limits</string>
    <string name="onboarding_limits_title">A ceiling for each app.</string>
    <string name="onboarding_limits_body">Give an app a number of minutes a day. When the time is spent, Foco pauses it for the rest of the day — a gentle stop, not a hard lockout. Great for the apps you want to keep, just less.</string>
    <string name="onboarding_strict_kicker">Strict mode</string>
    <string name="onboarding_strict_title">No escape hatch.</string>
    <string name="onboarding_strict_body">For a focus session with a set end, strict mode hides the way out until the timer runs down — so a moment of weakness can\'t undo the plan you made in a clearer one.</string>
    <string name="onboarding_dnd_kicker">Do Not Disturb</string>
    <string name="onboarding_dnd_title">Silence, while it lasts.</string>
    <string name="onboarding_dnd_body">Foco can switch on Do Not Disturb the instant focus begins and lift it the instant it ends — no buzzes or banners competing for the attention you just set aside.</string>
    <string name="onboarding_p6_kicker">Almost there</string>
    <string name="onboarding_p6_title">To make it real.</string>
    <string name="onboarding_p6_body">Two optional permissions turn on screen time and the real, phone-wide blocking. Your call — Foco works fine without them.</string>
